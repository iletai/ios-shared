# Shared Fastfile for iletai iOS apps. Apps load it with:
#   import_from_git(url: "https://github.com/iletai/ios-shared.git", branch: "main", path: "fastlane/Fastfile")
#
# App-specific values come only from ENV (commit non-secret ones in the app's fastlane/.env.default):
#   APP_IDENTIFIER, XCODE_PROJECT, SCHEME, APPLE_TEAM_ID            required
#   EXTRA_APP_IDENTIFIERS   comma list signed with the app (widgets, extensions)
#   TEST_SCHEME             scheme for `test` (default SCHEME); SCAN_* env is read by scan itself
#   BUILD_CONFIGURATION     archive configuration (default Release-Production)
#   SWIFT_PACKAGES          comma list of local package dirs run with `swift test` before the app tests
#   CAPABILITIES            comma list for `bootstrap`, e.g. HEALTHKIT,IN_APP_PURCHASE
#   APP_REVIEW_FIRST_NAME/LAST_NAME/PHONE/EMAIL[/NOTES]  for `release`
# Secrets: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT_BASE64 (CI) or ASC_KEY_PATH (local .p8),
#          MATCH_GIT_URL, MATCH_PASSWORD, FASTLANE_KEYCHAIN_PASSWORD (CI only).
require "base64"
require "json"
require "shellwords"

default_platform(:ios)

platform :ios do
  before_all do
    ensure_bundle_exec
    %w[APP_IDENTIFIER XCODE_PROJECT SCHEME APPLE_TEAM_ID].each do |key|
      UI.user_error!("Missing ENV #{key} (set it in fastlane/.env.default)") if ENV[key].to_s.empty?
    end
  end

  def env_list(key)
    ENV[key].to_s.split(",").map(&:strip).reject(&:empty?)
  end

  def app_identifiers
    [ENV["APP_IDENTIFIER"]] + env_list("EXTRA_APP_IDENTIFIERS")
  end

  def build_configuration
    ENV["BUILD_CONFIGURATION"] || "Release-Production"
  end

  def ci_keychain_password
    ENV.fetch("FASTLANE_KEYCHAIN_PASSWORD")
  end

  def match_profile_name(bundle_id)
    ENV["sigh_#{bundle_id}_appstore_profile-name"] || "match AppStore #{bundle_id}"
  end

  # Version from a v1.2.3 / release-1.2.3 tag; without a tag the xcconfig value is used.
  def marketing_version_xcarg
    version = ENV["RELEASE_VERSION"].to_s.sub(/\A(v|release-)/, "")
    version.match?(/\A\d+\.\d+\.\d+\z/) ? " MARKETING_VERSION=#{version}" : ""
  end

  # Precheck cannot read IAPs with an API key, so it is always off (see release-submit-gotchas).
  def deliver_base(api_key)
    { api_key: api_key, force: true, run_precheck_before_submit: false, precheck_include_in_app_purchases: false }
  end

  private_lane :setup_ci_keychain do
    next unless is_ci
    create_keychain(
      name: "ci_keychain",
      password: ci_keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )
  end

  # CI passes the key as base64; locally ASC_KEY_PATH points at the .p8 file.
  private_lane :asc_api_key do
    content = ENV["ASC_KEY_CONTENT_BASE64"].to_s.empty? ? nil : Base64.decode64(ENV["ASC_KEY_CONTENT_BASE64"])
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: content,
      key_filepath: content ? nil : ENV.fetch("ASC_KEY_PATH"),
      in_house: false
    )
  end

  desc "One-time local setup: register bundle IDs + CAPABILITIES, report the ASC record, create match profiles"
  lane :bootstrap do
    api_key = asc_api_key
    app_identifiers.each do |id|
      bundle = Spaceship::ConnectAPI::BundleId.find(id) ||
        Spaceship::ConnectAPI::BundleId.create(name: id.tr(".", " "), identifier: id, platform: "IOS")
      # Capabilities apply to the main app only; extensions rarely need them.
      next unless id == ENV["APP_IDENTIFIER"]
      env_list("CAPABILITIES").each do |type|
        next if bundle.get_capabilities.any? { |c| c.capability_type == type }
        bundle.create_capability(type)
        UI.success("Enabled #{type} on #{id}")
      end
    end
    app = Spaceship::ConnectAPI::App.find(ENV["APP_IDENTIFIER"])
    if app
      UI.success("App Store Connect record exists: #{app.name} (#{app.id})")
    else
      UI.important("No App Store Connect record for #{ENV['APP_IDENTIFIER']}. Create it once in the ASC web UI (the API cannot).")
    end
    match(app_identifier: app_identifiers, type: "appstore", readonly: false, api_key: api_key)
  end

  desc "Sync certificates and profiles via match (options: type:, readonly:)"
  lane :sync_signing do |options|
    setup_ci_keychain
    match(
      app_identifier: app_identifiers,
      type: options[:type] || "appstore",
      readonly: options[:readonly].nil? ? is_ci : options[:readonly],
      keychain_name: is_ci ? "ci_keychain" : nil,
      keychain_password: is_ci ? ci_keychain_password : nil,
      api_key: asc_api_key
    )
  end

  desc "Run local Swift package tests (SWIFT_PACKAGES) then the app tests (TEST_SCHEME)"
  lane :test do
    # sh runs inside fastlane/, package paths are relative to the repo root.
    env_list("SWIFT_PACKAGES").each { |dir| sh("cd ../#{dir} && swift test") }
    scan(
      project: ENV["XCODE_PROJECT"],
      scheme: ENV["TEST_SCHEME"] || ENV["SCHEME"],
      code_coverage: true,
      output_directory: "fastlane/test_output",
      output_types: "html,junit",
      fail_build: true
    )
  end

  # Signs every app identifier with its match profile, archives BUILD_CONFIGURATION; returns the build number.
  private_lane :build_signed do |options|
    api_key = options[:api_key]
    sync_signing(type: "appstore")

    # Map bundle IDs to targets via resolved build settings (xcconfig values included).
    settings = JSON.parse(sh(
      "xcodebuild -showBuildSettings -json -project ../#{ENV['XCODE_PROJECT'].shellescape} " \
      "-scheme #{ENV['SCHEME'].shellescape} -configuration #{build_configuration.shellescape} 2>/dev/null",
      log: false
    ))
    targets = settings.select { |s| app_identifiers.include?(s.dig("buildSettings", "PRODUCT_BUNDLE_IDENTIFIER")) }
    UI.user_error!("No target in #{ENV['SCHEME']} builds #{app_identifiers.join(', ')}") if targets.empty?
    targets.each do |s|
      update_code_signing_settings(
        path: ENV["XCODE_PROJECT"],
        use_automatic_signing: false,
        targets: [s["target"]],
        build_configurations: [build_configuration],
        team_id: ENV["APPLE_TEAM_ID"],
        code_sign_identity: "Apple Distribution",
        profile_name: match_profile_name(s.dig("buildSettings", "PRODUCT_BUNDLE_IDENTIFIER"))
      )
    end

    # max(latest TestFlight + 1, run number): TestFlight and App Store workflows have separate run counters.
    build_number = [
      latest_testflight_build_number(api_key: api_key, app_identifier: ENV["APP_IDENTIFIER"], initial_build_number: 0) + 1,
      ENV["GITHUB_RUN_NUMBER"].to_i
    ].max

    build_app(
      project: ENV["XCODE_PROJECT"],
      scheme: ENV["SCHEME"],
      configuration: build_configuration,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: app_identifiers.to_h { |id| [id, match_profile_name(id)] }
      },
      clean: true,
      output_directory: "./build",
      output_name: "#{ENV['SCHEME']}.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}#{marketing_version_xcarg}"
    )
    build_number
  end

  desc "Build and upload to TestFlight internal testers (option: changelog:)"
  lane :beta do |options|
    api_key = asc_api_key
    build_number = build_signed(api_key: api_key)

    changelog = options[:changelog]
    changelog ||= File.read(ENV["RELEASE_NOTES_FILE"]).strip if ENV["RELEASE_NOTES_FILE"] && File.exist?(ENV["RELEASE_NOTES_FILE"])
    changelog ||= begin
      previous_tag = sh("git describe --tags --abbrev=0 HEAD^ 2>/dev/null || true", log: false).strip
      range = previous_tag.empty? ? "-10" : "#{previous_tag}..HEAD"
      commits = sh("git log --pretty=format:'- %s' #{range} 2>/dev/null || true", log: false).strip
      commits.empty? ? "Build #{build_number}" : commits
    end

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
      distribute_external: false
    )
  end

  desc "Upload metadata only (fastlane/metadata), no binary or screenshots"
  lane :metadata do
    upload_to_app_store(**deliver_base(asc_api_key), skip_binary_upload: true, skip_screenshots: true)
  end

  desc "Capture screenshots (Snapfile); options: capture:false skips capture, upload:true pushes to ASC"
  lane :screenshots do |options|
    capture_screenshots unless options[:capture].to_s == "false"
    next unless options[:upload].to_s == "true"
    params = deliver_base(asc_api_key).merge(skip_binary_upload: true, skip_metadata: true, overwrite_screenshots: true)
    begin
      upload_to_app_store(**params)
    rescue StandardError => e
      # ASC screenshot uploads fail transiently; one retry was enough in practice.
      UI.important("Screenshot upload failed (#{e.message}), retrying in 10s")
      sleep(10)
      upload_to_app_store(**params)
    end
  end

  desc "Build, upload binary + metadata; submit:true submits for review, skip_build:true submits the latest processed build"
  lane :release do |options|
    api_key = asc_api_key
    skip_build = options[:skip_build].to_s == "true"
    build_signed(api_key: api_key) unless skip_build

    review_info = {
      first_name: ENV.fetch("APP_REVIEW_FIRST_NAME"),
      last_name: ENV.fetch("APP_REVIEW_LAST_NAME"),
      phone_number: ENV.fetch("APP_REVIEW_PHONE"),
      email_address: ENV.fetch("APP_REVIEW_EMAIL"),
      notes: ENV["APP_REVIEW_NOTES"]
    }.compact

    upload_to_app_store(
      **deliver_base(api_key),
      skip_binary_upload: skip_build,
      skip_screenshots: true,
      skip_metadata: options[:skip_metadata].to_s == "true" || ENV["SKIP_METADATA"] == "true",
      app_review_information: review_info,
      submit_for_review: options[:submit].to_s == "true",
      automatic_release: options[:automatic_release].to_s == "true",
      submission_information: { add_id_info_uses_idfa: false }
    )
  end
end
